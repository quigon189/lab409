# === Специфичное для a-h/templ ===
# Игнорируем сгенерированные Go-файлы из .templ шаблонов
*_templ.go

# === Инструменты разработки (Air для live-reload) ===
# Если используете инструмент Air для автоперезапуска приложения
/tmp/
.air.toml

# === Бинарники и сборка (Go) ===
# Исполняемые файлы компиляции
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Главный бинарник приложения (замените app на имя вашего бинарника, если нужно)
#/app

# === Управление зависимостями и окружением ===
# Локальные переменные окружения (секреты)
.env
.env.*
!.env.example

# Локальные файлы операционных систем
.DS_Store
Thumbs.db
